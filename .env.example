# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real IDs/hosts to the repository.
#
# Used by:
#   - app/backend (loaded at startup via python-dotenv)
#   - run_local.sh (sourced before launching uvicorn/vite)
# This file is ONLY for local development. Bundle deployment uses target.yml.
# The frontend does not read .env directly — it consumes the backend API,
# which serves dashboard/genie URLs already populated from these vars.

# ─── Databricks workspace ────────────────────────────────────────────────────
# Workspace host without protocol, e.g. adb-1234567890123456.7.azuredatabricks.net
# The numeric workspace id is parsed from this host at runtime (no separate var).
DATABRICKS_HOST=
# SQL warehouse id used by the backend to run queries
DATABRICKS_WAREHOUSE_ID=

# ─── Unity Catalog ───────────────────────────────────────────────────────────
DATABRICKS_CATALOG=rc18_catalog
SCHEMA_BRONZE=bronze
SCHEMA_SILVER=silver
SCHEMA_GOLD=gold
SCHEMA_QUALITY=quality
SCHEMA_REFERENCE=reference

# ─── Lakeview dashboards & Genie space ───────────────────────────────────────
DASHBOARD_ID_CONFORMIDADE=
DASHBOARD_ID_CRITICAS=
GENIE_SPACE_ID=

# ─── DQX Studio ──────────────────────────────────────────────────────────────
# REQUIRED for the complete local app: public URL of the DQX Studio app.
DQX_STUDIO_URL=https://<your-dqx-studio-app-host>
# Tela em que o Motor de Regras entra. Default `/registry-rules`; alternativas:
# /monitored-tables · / (home).
# DQX_STUDIO_ENTRY_PATH=/registry-rules
# Catálogo/schema DELTA da Studio: FQN das tabelas de EXECUÇÃO lidas via
# warehouse (dq_validation_runs + dq_metrics). Defaults: dqx / dqx_studio.
# DQX_CATALOG=<your-dqx-catalog>
# DQX_SCHEMA=<your-dqx-schema>
#
# ─── Lakebase Postgres da DQX Studio (as REGRAS) ─────────────────────────────
# Deixe VAZIO no dev local: sem endpoint, Críticas renderiza vazia em vez de erro.
# Para apontar num Lakebase real, sua identidade de CLI precisa de role Postgres
# + SELECT no schema da Studio, igual ao SP do app.
# DQX_LAKEBASE_ENDPOINT=projects/dqx-studio-db/branches/dqx/endpoints/primary
# DQX_LAKEBASE_DATABASE=databricks_postgres
# DQX_LAKEBASE_SCHEMA=dqx_studio
# DQX_RULES_TABLE=dq_quality_rules

# ─── App runtime ─────────────────────────────────────────────────────────────
# When true, the backend serves mock fixtures and never hits Databricks.
USE_MOCK_BACKEND=true

# Override the local dev ports if 8000/5173 are taken on your machine. The
# frontend's Vite proxy reads BACKEND_PORT to wire /api → backend.
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
