docs/
meta_prompt.md
.ai-dev-kit/
.claude/
.mcp.json

# Local secrets / environment overrides — never commit
.env
.env.local
.env.*.local
app/frontend/.env
app/frontend/.env.local

# Runtime-uploaded brand assets (logos). The app writes uploads here at runtime
# (app/backend/routers/branding.py); never commit customer logos. main.py
# recreates the dir on startup, so it does not need to exist in git.
app/backend/static/brand/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Node
node_modules/
app/frontend/build/
app/frontend/.svelte-kit/
dist/

# NOTE: app/backend/frontend_dist/ IS tracked in git so the Databricks Apps
# deploy doesn't depend on a local build step. Rebuild before commit:
#   cd app/frontend && npm run build && rm -rf ../backend/frontend_dist && cp -r build ../backend/frontend_dist

# Databricks
.databricks/
.databricks-resources.json

# Local bundle target generated from .env. Keep target.yml.example tracked;
# never commit the generated file with real workspace values.
target.yml

# IDE
.vscode/
.idea/
*.swp

# Playwright/screenshots
.playwright-mcp/
screenshot_*.png
.DS_Store
