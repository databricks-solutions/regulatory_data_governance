{
  "datasets": [
    {
      "name": "ds_dimensoes_status",
      "displayName": "Current Status of the 12 R.18 Dimensions",
      "queryLines": [
        "WITH rule_dims AS ( ",
        "  SELECT ",
        "    check:name::string AS check_name, ",
        "    check:user_metadata:dimensao_r18::string AS dimensao_r18 ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_quality_rules') ",
        "  WHERE status IN ('active', 'approved') ",
        "), dim_rules AS ( ",
        "  SELECT dimensao_r18, COUNT(*) AS rules_count ",
        "  FROM rule_dims WHERE dimensao_r18 IS NOT NULL ",
        "  GROUP BY dimensao_r18 ",
        "), latest_runs AS ( ",
        "  SELECT run_id, source_table_fqn, total_rows FROM ( ",
        "    SELECT run_id, source_table_fqn, total_rows, ",
        "      ROW_NUMBER() OVER (PARTITION BY source_table_fqn ORDER BY created_at DESC) AS rn ",
        "    FROM IDENTIFIER(:dqx_schema || '.dq_validation_runs') ",
        "    WHERE status = 'SUCCESS' ",
        "      AND source_table_fqn LIKE concat(:catalog, '.silver.%') ",
        "  ) WHERE rn = 1 ",
        "), metrics_explode AS ( ",
        "  SELECT lr.total_rows AS run_total_rows, cm.check_name, cm.error_count, cm.warning_count ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_metrics') m ",
        "  JOIN latest_runs lr ON lr.run_id = m.run_id ",
        "  LATERAL VIEW explode( ",
        "    from_json(m.metric_value, 'array<struct<check_name:string,error_count:bigint,warning_count:bigint>>') ",
        "  ) AS cm ",
        "  WHERE m.metric_name = 'check_metrics' ",
        "), dim_metrics AS ( ",
        "  SELECT rd.dimensao_r18, ",
        "    SUM(me.run_total_rows) AS total_rows, ",
        "    SUM(COALESCE(me.error_count, 0) + COALESCE(me.warning_count, 0)) AS invalid_rows ",
        "  FROM metrics_explode me ",
        "  JOIN rule_dims rd ON rd.check_name = me.check_name ",
        "  GROUP BY rd.dimensao_r18 ",
        ") ",
        "SELECT ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  d.meta_padrao_pct AS meta_pct, ",
        "  COALESCE(dr.rules_count, 0) AS rules_count, ",
        "  CASE ",
        "    WHEN COALESCE(dr.rules_count, 0) = 0 THEN 0.0 ",
        "    WHEN COALESCE(dm.total_rows, 0) = 0 THEN 100.0 ",
        "    ELSE ROUND(100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows, 2) ",
        "  END AS score_pct, ",
        "  CASE ",
        "    WHEN COALESCE(dr.rules_count, 0) = 0 THEN 'SEM REGRAS' ",
        "    WHEN COALESCE(dm.total_rows, 0) = 0 THEN 'CONFORME' ",
        "    WHEN 100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows >= d.meta_padrao_pct THEN 'CONFORME' ",
        "    WHEN 100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows >= d.meta_padrao_pct * 0.8 THEN 'ALERTA' ",
        "    ELSE 'CRITICO' ",
        "  END AS status ",
        "FROM IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ",
        "LEFT JOIN dim_rules dr ON dr.dimensao_r18 = d.dimensao_id ",
        "LEFT JOIN dim_metrics dm ON dm.dimensao_r18 = d.dimensao_id ",
        "ORDER BY d.dimensao_id"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "rc18_catalog"}]}
          }
        },
        {
          "displayName": "dqx_schema",
          "keyword": "dqx_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "dqx.dqx_studio"}]}
          }
        }
      ]
    },
    {
      "name": "ds_dimensoes_trend",
      "displayName": "Monthly Score Evolution by Dimension",
      "queryLines": [
        "WITH rule_dims AS ( ",
        "  SELECT ",
        "    check:name::string AS check_name, ",
        "    check:user_metadata:dimensao_r18::string AS dimensao_r18 ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_quality_rules') ",
        "  WHERE status IN ('active', 'approved') ",
        "), runs_6m AS ( ",
        "  SELECT run_id, total_rows, date_trunc('MONTH', created_at) AS mes ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_validation_runs') ",
        "  WHERE status = 'SUCCESS' ",
        "    AND source_table_fqn LIKE concat(:catalog, '.silver.%') ",
        "    AND created_at >= add_months(current_date(), -6) ",
        "), metrics_explode AS ( ",
        "  SELECT r.mes, r.total_rows AS run_total_rows, ",
        "    cm.check_name, cm.error_count, cm.warning_count ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_metrics') m ",
        "  JOIN runs_6m r ON r.run_id = m.run_id ",
        "  LATERAL VIEW explode( ",
        "    from_json(m.metric_value, 'array<struct<check_name:string,error_count:bigint,warning_count:bigint>>') ",
        "  ) AS cm ",
        "  WHERE m.metric_name = 'check_metrics' ",
        ") ",
        "SELECT ",
        "  me.mes, ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  CASE WHEN SUM(me.run_total_rows) = 0 THEN 100.0 ",
        "       ELSE ROUND(100.0 * (SUM(me.run_total_rows) - SUM(COALESCE(me.error_count,0) + COALESCE(me.warning_count,0))) / SUM(me.run_total_rows), 2) ",
        "  END AS score_pct ",
        "FROM metrics_explode me ",
        "JOIN rule_dims rd ON rd.check_name = me.check_name ",
        "JOIN IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ON d.dimensao_id = rd.dimensao_r18 ",
        "GROUP BY me.mes, d.dimensao_id, d.nome ",
        "ORDER BY me.mes, d.dimensao_id"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "rc18_catalog"}]}
          }
        },
        {
          "displayName": "dqx_schema",
          "keyword": "dqx_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "dqx.dqx_studio"}]}
          }
        }
      ]
    },
    {
      "name": "ds_kpi_summary",
      "displayName": "R.18 Compliance KPIs",
      "queryLines": [
        "WITH rule_dims AS ( ",
        "  SELECT ",
        "    check:name::string AS check_name, ",
        "    check:user_metadata:dimensao_r18::string AS dimensao_r18 ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_quality_rules') ",
        "  WHERE status IN ('active', 'approved') ",
        "), dim_rules AS ( ",
        "  SELECT dimensao_r18, COUNT(*) AS rules_count ",
        "  FROM rule_dims WHERE dimensao_r18 IS NOT NULL ",
        "  GROUP BY dimensao_r18 ",
        "), latest_runs AS ( ",
        "  SELECT run_id, total_rows FROM ( ",
        "    SELECT run_id, source_table_fqn, total_rows, ",
        "      ROW_NUMBER() OVER (PARTITION BY source_table_fqn ORDER BY created_at DESC) AS rn ",
        "    FROM IDENTIFIER(:dqx_schema || '.dq_validation_runs') ",
        "    WHERE status = 'SUCCESS' ",
        "      AND source_table_fqn LIKE concat(:catalog, '.silver.%') ",
        "  ) WHERE rn = 1 ",
        "), metrics_explode AS ( ",
        "  SELECT lr.total_rows AS run_total_rows, cm.check_name, cm.error_count, cm.warning_count ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_metrics') m ",
        "  JOIN latest_runs lr ON lr.run_id = m.run_id ",
        "  LATERAL VIEW explode( ",
        "    from_json(m.metric_value, 'array<struct<check_name:string,error_count:bigint,warning_count:bigint>>') ",
        "  ) AS cm ",
        "  WHERE m.metric_name = 'check_metrics' ",
        "), dim_metrics AS ( ",
        "  SELECT rd.dimensao_r18, ",
        "    SUM(me.run_total_rows) AS total_rows, ",
        "    SUM(COALESCE(me.error_count, 0) + COALESCE(me.warning_count, 0)) AS invalid_rows ",
        "  FROM metrics_explode me ",
        "  JOIN rule_dims rd ON rd.check_name = me.check_name ",
        "  GROUP BY rd.dimensao_r18 ",
        "), por_dim AS ( ",
        "  SELECT ",
        "    d.dimensao_id, ",
        "    d.meta_padrao_pct AS meta_pct, ",
        "    COALESCE(dr.rules_count, 0) AS rules_count, ",
        "    CASE ",
        "      WHEN COALESCE(dr.rules_count, 0) = 0 THEN 0.0 ",
        "      WHEN COALESCE(dm.total_rows, 0) = 0 THEN 100.0 ",
        "      ELSE ROUND(100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows, 2) ",
        "    END AS score_pct ",
        "  FROM IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ",
        "  LEFT JOIN dim_rules dr ON dr.dimensao_r18 = d.dimensao_id ",
        "  LEFT JOIN dim_metrics dm ON dm.dimensao_r18 = d.dimensao_id ",
        ") ",
        "SELECT ",
        "  ROUND(AVG(CASE WHEN rules_count > 0 THEN score_pct END), 2) AS score_medio, ",
        "  SUM(CASE WHEN rules_count > 0 AND score_pct >= meta_pct THEN 1 ELSE 0 END) AS dims_conformes, ",
        "  SUM(CASE WHEN rules_count = 0 THEN 1 ELSE 0 END) AS dims_sem_regras, ",
        "  COUNT(*) AS total_dims ",
        "FROM por_dim"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "rc18_catalog"}]}
          }
        },
        {
          "displayName": "dqx_schema",
          "keyword": "dqx_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "dqx.dqx_studio"}]}
          }
        }
      ]
    },
    {
      "name": "ds_deadline",
      "displayName": "Days Until R.18 Deadline (12/31/2026)",
      "queryLines": [
        "SELECT datediff(DATE '2026-12-31', current_date()) AS dias_restantes, ",
        "  current_date() AS hoje"
      ]
    },
    {
      "name": "ds_dimensoes_detalhe",
      "displayName": "Detail of the 12 Dimensions",
      "queryLines": [
        "WITH rule_dims AS ( ",
        "  SELECT ",
        "    check:name::string AS check_name, ",
        "    check:user_metadata:dimensao_r18::string AS dimensao_r18 ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_quality_rules') ",
        "  WHERE status IN ('active', 'approved') ",
        "), dim_rules AS ( ",
        "  SELECT dimensao_r18, COUNT(*) AS rules_count ",
        "  FROM rule_dims WHERE dimensao_r18 IS NOT NULL ",
        "  GROUP BY dimensao_r18 ",
        "), latest_runs AS ( ",
        "  SELECT run_id, source_table_fqn, total_rows FROM ( ",
        "    SELECT run_id, source_table_fqn, total_rows, ",
        "      ROW_NUMBER() OVER (PARTITION BY source_table_fqn ORDER BY created_at DESC) AS rn ",
        "    FROM IDENTIFIER(:dqx_schema || '.dq_validation_runs') ",
        "    WHERE status = 'SUCCESS' ",
        "      AND source_table_fqn LIKE concat(:catalog, '.silver.%') ",
        "  ) WHERE rn = 1 ",
        "), metrics_explode AS ( ",
        "  SELECT lr.total_rows AS run_total_rows, cm.check_name, cm.error_count, cm.warning_count ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_metrics') m ",
        "  JOIN latest_runs lr ON lr.run_id = m.run_id ",
        "  LATERAL VIEW explode( ",
        "    from_json(m.metric_value, 'array<struct<check_name:string,error_count:bigint,warning_count:bigint>>') ",
        "  ) AS cm ",
        "  WHERE m.metric_name = 'check_metrics' ",
        "), dim_metrics AS ( ",
        "  SELECT rd.dimensao_r18, ",
        "    SUM(me.run_total_rows) AS total_rows, ",
        "    SUM(COALESCE(me.error_count, 0) + COALESCE(me.warning_count, 0)) AS invalid_rows ",
        "  FROM metrics_explode me ",
        "  JOIN rule_dims rd ON rd.check_name = me.check_name ",
        "  GROUP BY rd.dimensao_r18 ",
        ") ",
        "SELECT ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  d.artigo_r18, ",
        "  d.meta_padrao_pct AS meta_pct, ",
        "  COALESCE(dr.rules_count, 0) AS rules_count, ",
        "  ROUND(CASE ",
        "    WHEN COALESCE(dr.rules_count, 0) = 0 THEN 0.0 ",
        "    WHEN COALESCE(dm.total_rows, 0) = 0 THEN 100.0 ",
        "    ELSE 100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows ",
        "  END, 2) AS score_pct, ",
        "  d.nivel_implementacao, ",
        "  CASE ",
        "    WHEN COALESCE(dr.rules_count, 0) = 0 THEN 'SEM REGRAS' ",
        "    WHEN COALESCE(dm.total_rows, 0) = 0 THEN 'CONFORME' ",
        "    WHEN 100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows >= d.meta_padrao_pct THEN 'CONFORME' ",
        "    WHEN 100.0 * (dm.total_rows - COALESCE(dm.invalid_rows, 0)) / dm.total_rows >= d.meta_padrao_pct * 0.8 THEN 'ALERTA' ",
        "    ELSE 'CRITICO' ",
        "  END AS status ",
        "FROM IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ",
        "LEFT JOIN dim_rules dr ON dr.dimensao_r18 = d.dimensao_id ",
        "LEFT JOIN dim_metrics dm ON dm.dimensao_r18 = d.dimensao_id ",
        "ORDER BY d.dimensao_id"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "rc18_catalog"}]}
          }
        },
        {
          "displayName": "dqx_schema",
          "keyword": "dqx_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "dqx.dqx_studio"}]}
          }
        }
      ]
    }
  ],
