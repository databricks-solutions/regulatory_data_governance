{
  "datasets": [
    {
      "name": "ds_incidents_por_dimensao",
      "displayName": "Incidentes por dimensão R.18",
      "queryLines": [
        "SELECT ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  COALESCE(i.documento, '—') AS documento, ",
        "  COALESCE(i.severidade, '—') AS severidade, ",
        "  COUNT(i.incident_id) AS total_incidentes, ",
        "  SUM(CASE WHEN i.status IS NOT NULL AND i.status NOT IN ('RESOLVED', 'VALIDATED') THEN 1 ELSE 0 END) AS abertos ",
        "FROM IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ",
        "LEFT JOIN IDENTIFIER(:catalog || '.governance.incidents') i ON i.dimensao_r18 = d.dimensao_id ",
        "GROUP BY d.dimensao_id, d.nome, i.documento, i.severidade ",
        "ORDER BY d.dimensao_id"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_funil_status",
      "displayName": "Funil de ciclo de vida dos incidentes",
      "queryLines": [
        "SELECT ",
        "  status, ",
        "  COUNT(*) AS qtd_incidentes ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') ",
        "GROUP BY status ",
        "ORDER BY CASE status ",
        "  WHEN 'DETECTED' THEN 1 ",
        "  WHEN 'ASSIGNED' THEN 2 ",
        "  WHEN 'RESPONDED' THEN 3 ",
        "  WHEN 'ESCALATED' THEN 4 ",
        "  WHEN 'RESOLVED' THEN 5 ",
        "  WHEN 'VALIDATED' THEN 6 ",
        "  WHEN 'REOPENED' THEN 7 ",
        "  ELSE 99 END"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_top_violations",
      "displayName": "Top 20 incidentes por taxa de violação",
      "queryLines": [
        "SELECT ",
        "  i.critica_id, ",
        "  i.check_name, ",
        "  i.documento, ",
        "  d.nome AS dimensao, ",
        "  i.severidade, ",
        "  i.status, ",
        "  i.affected_records, ",
        "  i.total_records, ",
        "  ROUND(i.taxa_violacao_pct, 2) AS taxa_violacao_pct, ",
        "  i.owner, ",
        "  i.detected_at ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') i ",
        "LEFT JOIN IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ON d.dimensao_id = i.dimensao_r18 ",
        "WHERE i.status NOT IN ('RESOLVED', 'VALIDATED') ",
        "ORDER BY i.taxa_violacao_pct DESC NULLS LAST ",
        "LIMIT 20"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_kpi_tmr",
      "displayName": "KPI Tempo Médio de Resolução (horas)",
      "queryLines": [
        "SELECT ",
        "  ROUND(AVG(timestampdiff(HOUR, detected_at, resolved_at)), 1) AS tmr_horas ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') ",
        "WHERE status IN ('RESOLVED', 'VALIDATED') ",
        "  AND detected_at IS NOT NULL AND resolved_at IS NOT NULL ",
        "  AND detected_at >= add_months(current_date(), -3)"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_kpi_bloqueantes",
      "displayName": "KPI Incidentes bloqueantes abertos",
      "queryLines": [
        "SELECT COUNT(*) AS bloqueantes_abertos ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') ",
        "WHERE severidade = 'BLOQUEANTE' ",
        "  AND status NOT IN ('RESOLVED', 'VALIDATED')"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_kpi_taxa_resolucao",
      "displayName": "KPI Taxa de resolução (últimos 30 dias)",
      "queryLines": [
        "SELECT ",
        "  ROUND(SUM(CASE WHEN status IN ('RESOLVED', 'VALIDATED') THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS taxa_resolucao_pct ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') ",
        "WHERE detected_at >= current_date() - INTERVAL 30 DAYS"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_tendencia_mensal",
      "displayName": "Tendência mensal: detectados vs resolvidos",
      "queryLines": [
        "WITH base AS ( ",
        "  SELECT ",
        "    date_trunc('MONTH', detected_at) AS mes, ",
        "    SUM(1) AS detectados, ",
        "    SUM(CASE WHEN status IN ('RESOLVED', 'VALIDATED') THEN 1 ELSE 0 END) AS resolvidos ",
        "  FROM IDENTIFIER(:catalog || '.governance.incidents') ",
        "  WHERE detected_at >= add_months(current_date(), -6) ",
        "  GROUP BY date_trunc('MONTH', detected_at) ",
        ") ",
        "SELECT mes, 'Detectados' AS tipo, detectados AS qtd FROM base ",
        "UNION ALL ",
        "SELECT mes, 'Resolvidos' AS tipo, resolvidos AS qtd FROM base ",
        "ORDER BY mes, tipo"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    },
    {
      "name": "ds_regras_por_dimensao",
      "displayName": "Regras DQX vinculadas por dimensão R.18",
      "queryLines": [
        "WITH rule_dims AS ( ",
        "  SELECT ",
        "    chk.user_metadata['dimensao_r18'] AS dimensao_r18 ",
        "  FROM IDENTIFIER(:dqx_schema || '.dq_quality_rules') ",
        "  LATERAL VIEW explode( ",
        "    from_json(checks, 'array<struct<name:string,user_metadata:map<string,string>>>') ",
        "  ) AS chk ",
        "  WHERE status IN ('active', 'approved') ",
        "), dim_rules AS ( ",
        "  SELECT dimensao_r18, COUNT(*) AS rules_count ",
        "  FROM rule_dims WHERE dimensao_r18 IS NOT NULL ",
        "  GROUP BY dimensao_r18 ",
        ") ",
        "SELECT ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  COALESCE(dr.rules_count, 0) AS rules_count, ",
        "  CASE WHEN COALESCE(dr.rules_count, 0) = 0 THEN 'SEM REGRAS' ELSE 'COM REGRAS' END AS estado_regras ",
        "FROM IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ",
        "LEFT JOIN dim_rules dr ON dr.dimensao_r18 = d.dimensao_id ",
        "ORDER BY d.dimensao_id"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "rc18_catalog"}]}
          }
        },
        {
          "displayName": "dqx_schema",
          "keyword": "dqx_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": "dqx_catalog.dqx_app"}]}
          }
        }
      ]
    },
    {
      "name": "ds_heatmap_dimensao_doc",
      "displayName": "Heatmap dimensão x documento",
      "queryLines": [
        "SELECT ",
        "  d.dimensao_id, ",
        "  d.nome AS dimensao, ",
        "  i.documento, ",
        "  COUNT(*) AS qtd_incidentes ",
        "FROM IDENTIFIER(:catalog || '.governance.incidents') i ",
        "JOIN IDENTIFIER(:catalog || '.reference.dimensoes_r18') d ON d.dimensao_id = i.dimensao_r18 ",
        "GROUP BY d.dimensao_id, d.nome, i.documento ",
        "ORDER BY d.dimensao_id, i.documento"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [{"value": "rc18_catalog"}]
            }
          }
        }
      ]
    }
  ],
