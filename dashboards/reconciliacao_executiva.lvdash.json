{
  "datasets": [
    {
      "name": "ds_recon_summary",
      "displayName": "Resumo Reconciliacao Mensal",
      "queryLines": [
        "SELECT dt_base, ",
        "  COUNT(*) AS total_modalidades, ",
        "  SUM(CASE WHEN diferenca_percentual > 0.5 THEN 1 ELSE 0 END) AS modalidades_fora_tolerancia, ",
        "  ROUND(AVG(diferenca_percentual), 4) AS divergencia_media, ",
        "  CASE ",
        "    WHEN MAX(diferenca_percentual) <= 0.1 THEN 'APROVADO' ",
        "    WHEN MAX(diferenca_percentual) <= 0.5 THEN 'ALERTA' ",
        "    ELSE 'BLOQUEIO' END AS status_reconciliacao ",
        "FROM rc18_catalog.gold.reconciliacao_3040_3050 ",
        "WHERE dt_base >= DATE_FORMAT(add_months(current_date(), -6), 'yyyy-MM') ",
        "GROUP BY dt_base"
      ]
    },
    {
      "name": "ds_recon_by_modality",
      "displayName": "Divergencia por Modalidade",
      "queryLines": [
        "SELECT modalidade_3050, dt_base, ",
        "  saldo_3040 AS vlr_3040, ",
        "  saldo_3050_reais AS vlr_3050, ",
        "  diferenca_absoluta AS vlr_divergencia, ",
        "  diferenca_percentual AS pct_divergencia, ",
        "  status ",
        "FROM rc18_catalog.gold.reconciliacao_3040_3050 ",
        "WHERE dt_base = (SELECT MAX(dt_base) FROM rc18_catalog.gold.reconciliacao_3040_3050)"
      ]
    },
    {
      "name": "ds_cosif_recon",
      "displayName": "Batimento COSIF",
      "queryLines": [
        "SELECT codigo_regra, descricao_regra, ",
        "  vlr_scr, vlr_cosif, vlr_diferenca, pct_diferenca, status ",
        "FROM rc18_catalog.gold.reconciliacao_cosif ",
        "WHERE dt_base = (SELECT MAX(dt_base) FROM rc18_catalog.gold.reconciliacao_cosif) ",
        "ORDER BY pct_diferenca DESC"
      ]
    },
    {
      "name": "ds_recon_trend",
      "displayName": "Tendencia Reconciliacao",
      "queryLines": [
        "SELECT dt_base, ",
        "  ROUND(AVG(diferenca_percentual), 4) AS divergencia_media, ",
        "  ROUND(MAX(diferenca_percentual), 4) AS divergencia_maxima ",
        "FROM rc18_catalog.gold.reconciliacao_3040_3050 ",
        "WHERE dt_base >= DATE_FORMAT(add_months(current_date(), -6), 'yyyy-MM') ",
        "GROUP BY dt_base ",
        "ORDER BY dt_base"
      ]
    },
    {
      "name": "ds_kpi_status_geral",
      "displayName": "KPI Status Geral",
      "queryLines": [
        "SELECT ",
        "  CASE ",
        "    WHEN MAX(diferenca_percentual) <= 0.1 THEN 'APROVADO' ",
        "    WHEN MAX(diferenca_percentual) <= 0.5 THEN 'ALERTA' ",
        "    ELSE 'BLOQUEIO' END AS status_geral, ",
        "  ROUND(AVG(diferenca_percentual), 4) AS divergencia_media, ",
        "  SUM(CASE WHEN diferenca_percentual > 0.5 THEN 1 ELSE 0 END) AS mods_fora_tolerancia ",
        "FROM rc18_catalog.gold.reconciliacao_3040_3050 ",
        "WHERE dt_base = (SELECT MAX(dt_base) FROM rc18_catalog.gold.reconciliacao_3040_3050)"
      ]
    }
  ],
