# Copie para docker/.env (ignorado pelo Git). Sem este arquivo o container sobe em modo mock.
# Mesmas variáveis que resources/app.yml injeta no Databricks App. Sem aspas nem comentário na
# mesma linha do valor — `docker run --env-file` lê tudo literalmente.

# ─── Identidade: service principal com OAuth secret (M2M) ────────────────────
DATABRICKS_HOST=https://<host-do-workspace>
DATABRICKS_CLIENT_ID=<client-id-do-sp>
DATABRICKS_CLIENT_SECRET=<oauth-secret-do-sp>
# Só para teste, PAT no lugar do SP (apague as duas linhas acima — o SDK recusa os dois juntos).
# DATABRICKS_TOKEN=<pat>

# ─── App ─────────────────────────────────────────────────────────────────────
USE_MOCK_BACKEND=false
DATABRICKS_CATALOG=rc18_catalog
DATABRICKS_WAREHOUSE_ID=<id-do-warehouse>
# IDs dos dashboards: `databricks bundle summary`.
DASHBOARD_ID_CONFORMIDADE=<id>
DASHBOARD_ID_CRITICAS=<id>
DISABLED_MODULES=xml

# ─── DQX Studio ──────────────────────────────────────────────────────────────
DQX_STUDIO_URL=https://<host-da-dqx-studio>
# Tabelas Delta de execução. Explícitas: o fallback do código é o catálogo RC18, não o do bundle.
DQX_CATALOG=dqx
DQX_SCHEMA=dqx_studio
# Lakebase das regras. `__unset__` desliga a leitura (Críticas SCR vazia).
DQX_LAKEBASE_ENDPOINT=projects/dqx-studio-db/branches/dqx/endpoints/primary

# ─── Opcionais — descomente só para sair do default (vazio NÃO é default) ────
# GENIE_SPACE_ID=<id>
# DQX_STUDIO_ENTRY_PATH=/registry-rules
# DQX_LAKEBASE_DATABASE=databricks_postgres
# DQX_LAKEBASE_SCHEMA=dqx_studio
# DQX_RULES_TABLE=dq_quality_rules
# SCHEMA_BRONZE=bronze
# SCHEMA_SILVER=silver
# SCHEMA_GOLD=gold
# SCHEMA_QUALITY=quality
# SCHEMA_REFERENCE=reference
# WEB_CONCURRENCY=2
# Porta publicada no host (só docker compose).
# RC18_PORT=8000
# Mirrors de pacote para o build, se a rede não alcança PyPI/npm públicos (só docker compose).
# PIP_INDEX_URL=<mirror-pypi>/simple
# NPM_CONFIG_REGISTRY=<mirror-npm>/
