# Copie para docker/.env (ignorado pelo Git). Só o que é do container: a config do
# app (catálogo, warehouse, DQX Studio, dashboards…) vem do target.yml, via
# docker/.env.bundle gerado pelo ./docker/setup.sh. Sem aspas nem comentário na
# mesma linha do valor — `--env-file` lê literal.

# ─── Identidade: service principal com OAuth secret (M2M, scope all-apis) ────
DATABRICKS_CLIENT_ID=<application-id-do-sp>
DATABRICKS_CLIENT_SECRET=<oauth-secret-do-sp>
# Só para teste, PAT no lugar do SP (apague as duas linhas acima — o SDK recusa os dois juntos).
# DATABRICKS_TOKEN=<pat>

# ─── Opcionais ───────────────────────────────────────────────────────────────
# Porta publicada no host (default 8010: a 8000 é a da DQX Studio local).
# RC18_PORT=8010
# Workers do uvicorn (default 2, como o app.yaml).
# WEB_CONCURRENCY=2
# Mirrors de pacote para o build, se a rede não alcança PyPI/npm públicos.
# PIP_INDEX_URL=<mirror-pypi>/simple
# NPM_CONFIG_REGISTRY=<mirror-npm>/
