# Copy to target.yml and replace the placeholders. target.yml is ignored by Git.
#
# REQUIRED: CLI profile and DQX Studio URL. The target is always `dev`;
# cloud/workspace selection belongs exclusively to the CLI profile.
# OPTIONAL: everything commented out. Defaults provision a catalog named
# rc18_catalog and a Serverless 2X-Small SQL warehouse automatically.
targets:
  dev:
    default: true
    workspace:
      profile: <your-databricks-cli-profile>
    variables:
      # REQUIRED — DQX Studio is a prerequisite, not an optional integration.
      dqx_studio_url: https://<your-dqx-studio-app-host>

      # Service principal do DQX Studio (o run_as dos jobs de validação).
      # Recebe leitura em rc18_catalog para que os checks com subquery (domínio/
      # referência/batimento + o filtro de escopo mensal) funcionem. 
      # dqx_studio_sp: <uuid-do-sp-da-dqx-studio>

      # OPTIONAL — catálogo/schema de vínculo com a DQX Studio (onde a Studio
      # persiste as regras). O FQN da tabela de regras é montado como
      # ${dqx_catalog}.${dqx_schema}.dq_quality_rules. Defaults: dqx_catalog / dqx_studio.
      # dqx_catalog: <your-dqx-catalog>
      # dqx_schema: <your-dqx-schema>

      # OPTIONAL — override do FQN completo, só se o nome da tabela divergir do
      # padrão dq_quality_rules. Normalmente basta ajustar dqx_catalog/dqx_schema acima.
      # dqx_checks_table: <your-dqx-catalog>.<your-dqx-schema>.dq_quality_rules

      

      # OPTIONAL — modo de orquestração do medallion bronze→silver→gold:
      #   • classical (DEFAULT) — jobs Databricks + notebooks PySpark, SEM
      #     nenhum recurso SDP/DLT. 
      #   • sdp — pipelines DLT/SDP declarativas (caminho original).
      # ATENÇÃO: esta variável só documenta/telemetriza a escolha. A troca REAL
      # dos recursos é feita no bloco `include:` do databricks.yml (comentar
      # resources/classical/*.yml e descomentar resources/pipelines/*.yml). Para
      # usar SDP: descomente a linha abaixo E faça essa troca no include.
      # pipeline_mode: sdp

      # OPTIONAL — omit both to let the bundle create and manage them.
      # If supplied, also remove/comment resources/catalog.yml or warehouse.yml
      # so the bundle does not create an unused duplicate resource.
      # catalog: <your-existing-catalog>
      # warehouse_id: <your-existing-sql-warehouse-id>

      # OPTIONAL — defaults are bronze, silver, gold, and quality.
      # schema_bronze: <your-bronze-schema>
      # schema_silver: <your-silver-schema>
      # schema_gold: <your-gold-schema>
      # schema_quality: <your-quality-schema>

      # OPTIONAL — Genie Space. Deixe omitido (default __unset__ = Genie
      # desativado, app mostra placeholder). Depois de provisionar o space via o
      # bundle opt-in `genie/` (ver genie/README.md), cole aqui o space_id gerado
      # e redeploy o core para o app embarcar o Genie.
      # genie_space_id: <your-genie-space-id>

      # OPTIONAL — ocultar módulos (menus da sidebar esquerda) neste ambiente.
      # CSV de slugs; default __none__ = todos visíveis. Slugs válidos:
      #   dashboard, quality, validations, rules, linking, governance, lineage,
      #   xml, genie, dash_conformidade, dash_criticas, reference
      # Ex.: ocultar só o Lineage → disabled_modules: lineage
      #      ocultar vários       → disabled_modules: lineage,genie,xml
      # disabled_modules: lineage
